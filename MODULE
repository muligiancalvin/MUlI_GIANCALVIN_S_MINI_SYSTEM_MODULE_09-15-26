 def get_float(prompt):
 while True:
 try:
 print(promt, end="", flush=True)
 sys.stdout.flush()
 return float(input())
 except ValueError:
 print(" >> No input received. Exiting program.")
 except EOError:
 print("\n >> No input received. Exiting program.")
 raise SystemExit
